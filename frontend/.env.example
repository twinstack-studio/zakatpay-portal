# Copy to .env.local (dev) or set in your host's dashboard (production).
# Vite only exposes variables that start with VITE_.

# Where the backend API lives. No trailing slash.
#   local:      http://localhost:5001
#   production: https://your-api.onrender.com
VITE_API_URL=

# Google OAuth client id for the "Continue with Google" button
VITE_GOOGLE_CLIENT_ID=
