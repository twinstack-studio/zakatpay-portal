# Copy to .env and fill in. Never commit the real .env.
PORT=5001

# MongoDB Atlas connection string
MONGO_URI=

# Long random string used to sign login sessions.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Gmail account that sends the OTP emails.
# EMAIL_PASS must be a 16-character Google App Password, NOT your login password.
EMAIL_USER=
EMAIL_PASS=

# Comma-separated list of sites allowed to call this API.
# Leave empty in local development to allow everything.
# Example: https://zakatpay.vercel.app,https://www.zakatpay.pk
ALLOWED_ORIGINS=

# Set true to also allow Vercel preview URLs (*.vercel.app)
ALLOW_VERCEL_PREVIEWS=false
